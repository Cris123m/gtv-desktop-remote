{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM"],
    "noEmit": true
  },
  "include": ["playwright.integration.config.ts", "tests/integration/**/*.ts", "src/shared/**/*.ts"]
}
